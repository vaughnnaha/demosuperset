# Devin API key (https://app.devin.ai/settings/api-keys). Never commit the real value.
DEVIN_API_KEY=

# Token used to comment on the issue. In Actions this is the built-in GITHUB_TOKEN.
GITHUB_TOKEN=

# Path to the GitHub event payload. Actions sets this automatically.
GITHUB_EVENT_PATH=./sample_event.json

# Optional: poll the session for this many seconds and comment the PR link when found.
POLL_TIMEOUT_SECONDS=0

# Optional overrides
# DEVIN_API_BASE=https://api.devin.ai/v1
# GITHUB_API_URL=https://api.github.com
